<?php
$exec = "/usr/local/emhttp/plugins/sound-driver/include/exec.sh";
$selected_output = (string)shell_exec("$exec get_selected_output");

//Outputs found at the last driver load, written by the plugin
$filename = "/tmp/sound_outputs";
$eachlines = is_file($filename) ? file($filename, FILE_IGNORE_NEW_LINES) : [];

//The build script holds this lock while it waits for Docker and builds
$lock = @fopen("/var/run/sound-driver-build.lock", "c");
$building = $lock && !flock($lock, LOCK_EX | LOCK_NB);
if ($lock) fclose($lock);

$log = "/var/log/sound-driver-build.log";
if ($building) {
  $status = "Sound drivers are being built, you will be notified when they are loaded. Log: $log";
} elseif (!is_dir("/proc/asound") || !$eachlines) {
  $failed = is_file($log) && strpos(file_get_contents($log), "ERROR:") !== false;
  $status = ($failed ? "Building the sound drivers failed." : "No sound card found.")." Log: $log";
} else {
  $status = "";
}
?>

