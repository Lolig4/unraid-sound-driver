<?xml version="1.0" standalone="yes"?>
<!DOCTYPE PLUGIN [
<!ENTITY name "sound-driver">
<!ENTITY author "Lolig4">
<!ENTITY version "2026.09.30b">
<!ENTITY launch "Settings/sound-driver">
<!ENTITY gitURL "https://github.com/&author;/unraid-&name;/raw/master">
<!ENTITY pluginURL "&gitURL;/&name;.plg">
<!ENTITY plugin "/boot/config/plugins/&name;">
<!ENTITY emhttp "/usr/local/emhttp/plugins/&name;">
<!ENTITY packages "/boot/config/plugins/&name;/packages">
]>
<PLUGIN name="&name;" author="&author;" version="&version;" launch="&launch;" pluginURL="&pluginURL;" min="6.9.2" support="https://github.com/&author;/unraid-&name;/issues">

<CHANGES>

###2026.09.30b
- Build all sound drivers (PCI, HDA codecs, USB, FireWire), skipping only those the Unraid kernel can't load
- Build ALSA 1.2.16 with UCM from source, alsactl init works again
- Restart containers using /dev/snd after the drivers are (re)loaded, so they see the sound card
- Fix output selection: keep the whole device name and convert formats as needed
- Fix PHP deprecation warning on the settings page

###2026.09.30a
- Settings page shows whether the drivers are being built instead of PHP warnings

###2026.09.30
- Build the sound drivers locally against the running kernel instead of downloading prebuilt packages, which failed to load (unknown acpi_nhlt_* symbols)
- Build runs in the background once Docker is up and reports via notification
- Dropped the Plugin Update Helper, packages are rebuilt automatically after a kernel change
- Settings page is installed from the sources in the repository instead of a prebuilt package

###2022.07.21
- Version detection from package via GitHub API
- Save md5 in packages directory

###2022.07.20
- Necessary changes for unRAID 6.11+
- Cleanup

###2022.04.11
- Added Plugin Update Helper when up-/downgrading unRAID version

###2021.06.23
- Changed package download repo

###2021.04.19
- Initial release

</CHANGES>

<FILE Run="/bin/bash">
<INLINE>
  rm -f /boot/config/plugins/&name;/&name;*.txz
  rm -rf $(ls -d /boot/config/plugins/&name;/ui-* 2&gt;/dev/null|grep -v '&version;')
  rm -f $(ls /boot/config/plugins/&name;/build-local-*.sh 2&gt;/dev/null|grep -v '&version;')
  rm -f /boot/config/plugins/&name;/plugin_update_helper
</INLINE>
</FILE>

<!-- Settings page, kept on flash so it also installs on boot without network -->
<FILE Name="&plugin;/ui-&version;/sound-driver.page">
<URL>&gitURL;/source/emhttp/sound-driver.page</URL>
</FILE>

<FILE Name="&plugin;/ui-&version;/include/exec.sh">
<URL>&gitURL;/source/emhttp/include/exec.sh</URL>
</FILE>

<FILE Name="&plugin;/ui-&version;/include/test.sh">
<URL>&gitURL;/source/emhttp/include/test.sh</URL>
</FILE>

<FILE Name="&plugin;/ui-&version;/images/sound-driver.png">
<URL>&gitURL;/source/emhttp/images/sound-driver.png</URL>
</FILE>

<FILE Run="/bin/bash">
<INLINE>
  mkdir -p &emhttp;
  cp -r &plugin;/ui-&version;/. &emhttp;/
  chmod -R u=rwX,go=rX &emhttp;
  chmod 755 &emhttp;/include/*.sh
</INLINE>
</FILE>

<FILE Name="&plugin;/build-local-&version;.sh">
<URL>&gitURL;/source/build-local.sh</URL>
</FILE>

<FILE Name="&emhttp;/README.md">
<INLINE>
**Sound Driver**

This package contains the Sound Drivers (and also a custom ALSA build) that enables you to make use of your Soundcard in Unraid.
</INLINE>
</FILE>

<FILE Run="/bin/bash">
<INLINE>

install() {
# Install Sound Drivers
/sbin/installpkg "${LOCAL_PKG}"
depmod -a 2>/dev/null
sleep 1
udevadm control --reload 2>/dev/null &amp;&amp; udevadm trigger --action=add 2>/dev/null
sleep 3
}

set_default_device() {
&emhttp;/include/exec.sh apply_output
}

activate() {
if [ ! -d &plugin;/conf ]; then
  mkdir -p &plugin;/conf
fi
if [ ! -f &plugin;/conf/asound.state ]; then
  alsactl init 2>/dev/null
  alsactl store -f &plugin;/conf/asound.state 2>/dev/null
else
  alsactl restore -f &plugin;/conf/asound.state 2>/dev/null
fi
echo -n "$(aplay -L | grep "CARD")" > /tmp/sound_outputs
}

# Define Variables
KERNEL_V="$(uname -r)"
PKG_DIR="&packages;/${KERNEL_V%%-*}"

if [ ! -d "${PKG_DIR}" ]; then
  mkdir -p "${PKG_DIR}"
fi

#Create settings file if not found
if [ ! -f "&plugin;/settings.cfg" ]; then
  echo 'primary_audio_device=empty' > "&plugin;/settings.cfg"
fi

#Check for old packages
rm -rf $(ls -d &packages;/* | grep -v "${KERNEL_V%%-*}")

#Only use packages built on this server, drop anything else (e.g. prebuilt
#packages fetched by ich777's Plugin Update Helper)
find "${PKG_DIR}" -maxdepth 1 -name 'sound*' ! -name "sound-*-${KERNEL_V}-local.txz*" -delete
LOCAL_PKG="$(ls -1 ${PKG_DIR}/sound-*-${KERNEL_V}-local.txz 2>/dev/null | sort -V | tail -1)"

set_default_device

if [ -n "${LOCAL_PKG}" ]; then
  echo
  echo "-------------------------Sound Drivers found locally-------------------------"
  if [ ! -f /usr/sbin/alsactl ]; then
    install &gt; /dev/null
  fi
  activate
  echo
  echo "------------------Installation of Sound Drivers successful-------------------"
  echo
else
  echo
  echo "-----------No Sound Drivers built for Kernel ${KERNEL_V} yet------------"
  echo "----The build starts in the background as soon as Docker is running,-----"
  echo "-------------------you will be notified when it's done!------------------"
  echo
  echo "bash &plugin;/build-local-&version;.sh --wait-docker --install --notify &gt; /var/log/sound-driver-build.log 2&gt;&amp;1" | at now &gt; /dev/null 2&gt;&amp;1
fi

</INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE>

echo "--------------------------------"
echo "---Uninstalling Sound Drivers---"
echo "--------------------------------"
# Unload the drivers if nothing is using them anymore
for i in 1 2 3 4 5; do
  for m in $(lsmod | awk '$1 ~ /^snd|^soundcore$/ {print $1}'); do
    rmmod "${m}" 2&gt;/dev/null
  done
done
# Remove the locally built package (kernel modules and ALSA)
for pkg in /var/log/packages/sound-*-local; do
  [ -e "${pkg}" ] &amp;&amp; removepkg "$(basename "${pkg}")" &gt; /dev/null
done
if lsmod | grep -qE "^(snd|soundcore)"; then
  echo "Sound drivers are still in use, they are gone after the reboot"
fi
# Remove plugin related files
rm -f /etc/asound.conf /tmp/sound_outputs /var/log/sound-driver-build.log /var/run/sound-driver-build.lock
rm -rf &emhttp;
rm -rf &plugin;
echo
echo "------------------------------------------------------------------"
echo "------Sound Drivers uninstalled, please reboot your server!-------"
echo "------------------------------------------------------------------"
echo

</INLINE>
</FILE>
</PLUGIN>